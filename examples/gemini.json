{
  "operation": {
    "log_level": "info"
  },
  "__meta__": {
    "target_prio_str_keys": [
      "prompt"
    ],
    "input_prio_str_keys": [],
    "input_prio_keys": []
  },
  "oai": {
    "open_ai_base": "generativelanguage.googleapis.com",
    "open_ai_endpoint": "/v1beta/openai/chat/completions",
    "open_ai_key": "REPLACE_WITH_GEMINI_API_KEY",
    "model": "YOUR_GEMINI_MODEL",
    "temperature": 0.2,
    "max_tokens": 2000,
    "max_seconds": 120,
    "http_timeout": 60
  },
  "alternates": {
    "default": ""
  },
  "command_generate": {
    "persona": "You are a helpful coding assistant.",
    "keep_prompt_text": true
  },
  "command_edits": {
    "persona": "Edit the supplied text according to the instruction. Return only the edited text.",
    "keep_prompt_text": false
  }
}
