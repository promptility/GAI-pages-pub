{
  "operation": {
    "log_level": "info"
  },
  "__meta__": {
    "target_prio_str_keys": [
      "prompt"
    ],
    "input_prio_str_keys": [],
    "input_prio_keys": []
  },
  "oai": {
    "open_ai_base": "api.openai.com",
    "open_ai_endpoint": "/v1/chat/completions",
    "open_ai_key": "REPLACE_WITH_OPENAI_API_KEY",
    "model": "gpt-4.1-mini",
    "temperature": 0.2,
    "max_tokens": 2000,
    "max_seconds": 120,
    "http_timeout": 60
  },
  "alternates": {
    "default": "openai",
    "openai": {
      "open_ai_base": "api.openai.com",
      "open_ai_endpoint": "/v1/chat/completions",
      "open_ai_key": "REPLACE_WITH_OPENAI_API_KEY",
      "model": "gpt-4.1-mini"
    },
    "openrouter": {
      "open_ai_base": "openrouter.ai",
      "open_ai_endpoint": "/api/v1/chat/completions",
      "open_ai_key": "REPLACE_WITH_OPENROUTER_API_KEY",
      "model": "openai/gpt-4.1-mini"
    }
  },
  "command_generate": {
    "persona": "You are a helpful coding assistant.",
    "keep_prompt_text": true
  },
  "command_edits": {
    "persona": "Edit the supplied text according to the instruction. Return only the edited text.",
    "keep_prompt_text": false
  }
